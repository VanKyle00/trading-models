# Copy this file to .env and fill in keys you need. .env is gitignored.

# --- Equities ---
POLYGON_API_KEY=your_polygon_key_here
ALPACA_API_KEY_ID=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here

# --- Alternative data ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret
REDDIT_USER_AGENT=trading-models/0.1 by your_username

NEWSAPI_KEY=your_newsapi_key_here

# --- Crypto ---
# Binance and Coinbase public endpoints do NOT need keys for read-only market data.
# Add keys only if you call authenticated endpoints (account balance, trade history, etc).
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
